  else { ctx.fillStyle="#7CC6E8"; ctx.fillRect(x,y,jugador.w,jugador.h); ctx.fillStyle="black"; ctx.fillRect(x+10,y+10,8,8); }
}
function dibujarEnemigo(e){ let x=e.x-camaraX, y=e.y; ctx.fillStyle="rgba(0,0,0,0.25)"; ctx.beginPath(); ctx.ellipse(x+e.w/2,362,16,3,0,0,Math.PI*2); ctx.fill(); ctx.save(); ctx.shadowColor="rgba(0,0,0,0.3)"; ctx.shadowBlur=4; if(e.tipo==="volador"){ ctx.fillStyle="#6A0DAD"; ctx.beginPath(); ctx.roundRect(x,y+8,e.w,e.h-8,8); ctx.fill(); ctx.fillStyle="white"; ctx.beginPath(); ctx.roundRect(x+5,y,24,12,4); ctx.fill(); ctx.fillStyle="black"; ctx.fillRect(x+8,y+3,5,5); ctx.fillRect(x+18,y+3,5,5); } else if(e.tipo==="rapido"){ let g=ctx.createLinearGradient(x,y,x,y+e.h); g.addColorStop(0,"#FF6B6B"); g.addColorStop(1,"#C0392B"); ctx.fillStyle=g; ctx.beginPath(); ctx.roundRect(x,y+8,e.w,e.h-8,6); ctx.fill(); ctx.beginPath(); ctx.roundRect(x+3,y,28,16,4); ctx.fill(); ctx.fillStyle="#FFD700"; ctx.fillRect(x+6,y+4,6,6); ctx.fillRect(x+19,y+4,6,6); } else { let g=ctx.createLinearGradient(x,y,x,y+e.h); g.addColorStop(0,"#B0B0B0"); g.addColorStop(1,"#666"); ctx.fillStyle=g; ctx.beginPath(); ctx.roundRect(x,y+8,e.w,e.h-8,6); ctx.fill(); ctx.beginPath(); ctx.roundRect(x+3,y,28,16,4); ctx.fill(); ctx.fillStyle="#FFD700"; ctx.beginPath(); ctx.arc(x+9,y+7,3,0,Math.PI*2); ctx.fill(); ctx.beginPath(); ctx.arc(x+22,y+7,3,0,Math.PI*2); ctx.fill(); } ctx.restore(); }
function dibujarMoneda(m){ let mx=m.x-camaraX; let esc=Math.abs(Math.sin(frame*0.1+m.x*0.01)); let an=8+esc*14; ctx.fillStyle="rgba(255,215,0,0.3)"; ctx.beginPath(); ctx.ellipse(mx+10,m.y+5,16,6,0,0,Math.PI*2); ctx.fill(); ctx.save(); ctx.translate(mx+10,m.y); ctx.scale(an/22,1); let g=ctx.createRadialGradient(0,0,2,0,0,14); g.addColorStop(0,"#FFD98E"); g.addColorStop(0.7,"#E8A85C"); g.addColorStop(1,"#B87333"); ctx.fillStyle=g; ctx.beginPath(); ctx.arc(0,0,12,0,Math.PI*2); ctx.fill(); ctx.fillStyle="#5C3317"; ctx.beginPath(); ctx.arc(-4,-3,1.5,0,Math.PI*2); ctx.fill(); ctx.beginPath(); ctx.arc(4,2,1.5,0,Math.PI*2); ctx.fill(); ctx.restore(); }
function dibujarBloque(b){ let bx=b.x-camaraX; let g=ctx.createLinearGradient(bx,b.y,bx,b.y+30); if(b.t){ g.addColorStop(0,"#A0522D"); g.addColorStop(1,"#5C3317"); } else { g.addColorStop(0,"#FFE55C"); g.addColorStop(0.5,"#FFD700"); g.addColorStop(1,"#DAA520"); } ctx.fillStyle=g; ctx.beginPath(); ctx.roundRect(bx,b.y,30,30,4); ctx.fill(); ctx.fillStyle=b.t?"#DDD":"#8B4513"; ctx.font="bold 18px Arial"; ctx.textAlign="center"; ctx.fillText(b.t?"✓":"?",bx+15,b.y+22); }

function actualizar(){
  if(!juegoEmpezado||pausado) return;
  frame++;
  for(let p of particulas){ p.x+=p.vx; p.y+=p.vy; p.vy+=0.2; p.vida--; } particulas=particulas.filter(p=>p.vida>0);
  if(Date.now()-ultimoSegundo>=1000){ tiempoRestante--; ultimoSegundo=Date.now(); document.getElementById("tiempoTxt").innerText=tiempoRestante; let porc=(tiempoRestante/nivel.tiempo)*100; document.getElementById("tiempoFill").style.width=porc+"%"; document.getElementById("tiempoPorc").innerText=Math.round(porc)+"%"; if(tiempoRestante<=0){ perderVida("⏰ ¡Se acabó el tiempo!"); tiempoRestante=nivel.tiempo; } }
  if(teclas["ArrowLeft"]){ jugador.vx=-4.5; jugador.mirando="izquierda"; } else if(teclas["ArrowRight"]){ jugador.vx=4.5; jugador.mirando="derecha"; } else jugador.vx=0;
  jugador.vy+=0.65; jugador.x+=jugador.vx; jugador.y+=jugador.vy; jugador.enSuelo=false;
