  if(jugador.x<0) jugador.x=0; if(jugador.x>nivel.largo) jugador.x=nivel.largo; if(jugador.y>500){ perderVida("🕳️ ¡Te caíste!"); return; } if(jugador.invencible>0) jugador.invencible--;
  camaraX=jugador.x-300; if(camaraX<0) camaraX=0; if(camaraX>nivel.largo-800) camaraX=nivel.largo-800;
  if(nivelActual>=8){ shakeX=Math.random()*2-1; shakeY=Math.random()*2-1; } else if(shakeX!==0||shakeY!==0){ shakeX*=0.8; shakeY*=0.8; if(Math.abs(shakeX)<0.2) shakeX=0; if(Math.abs(shakeY)<0.2) shakeY=0; }
  for(let m of nivel.monedas){ if(!m.t && Math.abs(jugador.x-m.x)<30 && Math.abs(jugador.y-m.y)<35){ m.t=true; monedas++; puntos+=50; document.getElementById("monedas").innerText=monedas; document.getElementById("puntos").innerText=puntos; sMoneda(); guardarRecord(); for(let i=0;i<8;i++) particulas.push({x:m.x,y:m.y,vx:(Math.random()-0.5)*4,vy:(Math.random()-0.5)*4,vida:25,color:"#FFD700"}); if(nivelActual>=7) shakeY=2; } }
  for(let b of nivel.bloques){ if(!b.t && jugador.x+jugador.w>b.x && jugador.x<b.x+30 && jugador.y<b.y+30 && jugador.y+jugador.h>b.y){ if(jugador.vy<0){ b.t=true; puntos+=100; document.getElementById("puntos").innerText=puntos; sMoneda(); jugador.vy=4; } } }
  for(let e of nivel.enemigos){ if(!e.vivo) continue; if(e.tipo==="volador"){ e.x+=e.vx*e.dir; e.y=e.baseY+Math.sin(frame*0.05+e.x*0.01)*30; } else { e.x+=e.vx*e.dir; if(Math.random()<0.005) e.dir*=-1; if(e.x<0) e.dir=1; } if(e.x<jugador.x-700||e.x>jugador.x+700) continue; if(jugador.x+jugador.w>e.x && jugador.x<e.x+e.w && jugador.y+jugador.h>e.y && jugador.y<e.y+e.h){ if(jugador.vy>2 && jugador.y<e.y+10){ e.vivo=false; puntos+=100; document.getElementById("puntos").innerText=puntos; jugador.vy=-10; sEnemigo(); document.getElementById("mensaje").innerText="¡Pisaste al enemigo! +100"; if(nivelActual>=6) shakeY=4; } else if(jugador.invencible<=0){ perderVida("😼 ¡Te tocó un enemigo!"); return; } } }
  if(jugador.x>nivel.meta.x-20){ if(nivelActual<10){ puntos+=500; document.getElementById("puntos").innerText=puntos; sNivel(); nivelActual++; cargarNivel(nivelActual); document.getElementById("mensaje").innerText="🎉 ¡Nivel completado! +500 - 🔊 Vol "+getVolumenPorc()+"% - 🔥 Intensidad "+getIntensidad()+"%"; shakeX=8; shakeY=8; guardarRecord(); } else { sGanar(); guardarRecord(); document.getElementById("textoVictoria").innerText="¡Ganaste los 10 niveles! Puntos: "+puntos+" | Galletas: "+monedas+" | Récord: "+record; document.getElementById("pantallaVictoria").classList.remove("hidden"); juegoEmpezado=false; jugador.x=-1000; } }
}
function dibujar(){
  ctx.clearRect(0,0,800,400); ctx.save(); ctx.translate(shakeX,shakeY); dibujarFondoRealista();
  for(let p of nivel.plataformas){ if(p.y===360){ let segs=[]; let lastX=p.x; let sh=nivel.huecos.slice().sort((a,b)=>a.x-b.x); for(let h of sh){ if(h.x>=p.x && h.x<=p.x+p.w){ segs.push({x:lastX,w:h.x-lastX}); lastX=h.x+h.w; } } segs.push({x:lastX,w:p.x+p.w-lastX}); dibujarSueloRealista(p,segs); } else dibujarPlataformaRealista(p); }
  for(let b of nivel.bloques) dibujarBloque(b); for(let m of nivel.monedas) if(!m.t) dibujarMoneda(m); for(let e of nivel.enemigos) if(e.vivo) dibujarEnemigo(e);
  let mx=nivel.meta.x-camaraX; ctx.fillStyle="#8B4513"; ctx.fillRect(mx,150,6,210); ctx.fillStyle="#FFD700"; ctx.beginPath(); ctx.arc(mx+3,150,6,0,Math.PI*2); ctx.fill(); let onda=Math.sin(frame*0.1)*4; let gb=ctx.createLinearGradient(mx,150,mx+70,150); gb.addColorStop(0,"#00C853"); gb.addColorStop(1,"#00FF00"); ctx.fillStyle=gb; ctx.beginPath(); ctx.moveTo(mx+6,150); ctx.lineTo(mx+70,155+onda); ctx.lineTo(mx+70,185+onda); ctx.lineTo(mx+6,185); ctx.closePath(); ctx.fill(); ctx.fillStyle="white"; ctx.font="bold 13px Arial"; ctx.fillText("🏁 META",mx+10,172);
