  for(let i=0;i<6;i++){ let tx=(i*500-camaraX*0.5)%3000; if(tx<-100) tx+=3000; ctx.fillStyle="#8B4513"; ctx.fillRect(tx,300,12,60); let ga=ctx.createRadialGradient(tx+6,290,5,tx+6,290,45); ga.addColorStop(0,"#2ECC71"); ga.addColorStop(1,"#1E8449"); ctx.fillStyle=ga; ctx.beginPath(); ctx.arc(tx+6,280,32,0,Math.PI*2); ctx.fill(); }
}
function dibujarSueloRealista(p,segments){ for(let s of segments){ if(s.w<=0) continue; let sx=s.x-camaraX; let gt=ctx.createLinearGradient(0,360,0,400); if(nivelActual>=9){ gt.addColorStop(0,"#4B0000"); gt.addColorStop(1,"#1A0000"); } else { gt.addColorStop(0,"#8B5A2B"); gt.addColorStop(0.3,"#A0522D"); gt.addColorStop(1,"#5C3317"); } ctx.fillStyle=gt; ctx.fillRect(sx,360,s.w,40); let gp=ctx.createLinearGradient(0,360,0,375); if(nivelActual>=9){ gp.addColorStop(0,"#FF4500"); gp.addColorStop(1,"#8B0000"); } else { gp.addColorStop(0,"#7CFC00"); gp.addColorStop(0.5,"#2ECC71"); gp.addColorStop(1,"#27AE60"); } ctx.fillStyle=gp; ctx.beginPath(); ctx.roundRect(sx,360,s.w,14,4); ctx.fill(); ctx.strokeStyle=nivelActual>=9?"#FF6B00":"#1E8449"; ctx.lineWidth=1; for(let bx=sx+5; bx<sx+s.w-5; bx+=12){ ctx.beginPath(); ctx.moveTo(bx,362); ctx.lineTo(bx+2,356); ctx.stroke(); } ctx.fillStyle="rgba(255,255,255,0.25)"; ctx.fillRect(sx,360,s.w,3); } }
function dibujarPlataformaRealista(p){ let sx=p.x-camaraX; let gm=ctx.createLinearGradient(0,p.y,0,p.y+p.h); if(nivelActual>=9){ gm.addColorStop(0,"#FF6B00"); gm.addColorStop(1,"#8B0000"); } else { gm.addColorStop(0,"#E8A85C"); gm.addColorStop(0.5,"#C47A2E"); gm.addColorStop(1,"#8B4513"); } ctx.fillStyle=gm; ctx.beginPath(); ctx.roundRect(sx,p.y,p.w,p.h,6); ctx.fill(); ctx.fillStyle="rgba(255,255,255,0.35)"; ctx.beginPath(); ctx.roundRect(sx,p.y,p.w,4,2); ctx.fill(); }
function dibujarBluey(){
  let x=jugador.x-camaraX, y=jugador.y; let altura=Math.max(0,360-(y+jugador.h)); let an=22-Math.min(10,altura*0.05); let op=0.3-Math.min(0.2,altura*0.001); if(op<0.05) op=0.05; ctx.fillStyle="rgba(0,0,0,"+op+")"; ctx.beginPath(); ctx.ellipse(x+jugador.w/2,362,an,4,0,0,Math.PI*2); ctx.fill();
