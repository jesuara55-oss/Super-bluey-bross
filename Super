  for(let p of particulas){ ctx.fillStyle=p.color; ctx.globalAlpha=p.vida/25; ctx.beginPath(); ctx.arc(p.x-camaraX,p.y,3,0,Math.PI*2); ctx.fill(); } ctx.globalAlpha=1;
  let intensidad=getIntensidad()/100; if(nivelActual>=3){ let grad=ctx.createRadialGradient(400,200,180,400,200,450); grad.addColorStop(0,"rgba(255,0,0,0)"); grad.addColorStop(1,"rgba(255,0,0,"+(0.15+intensidad*0.65)+")"); ctx.fillStyle=grad; ctx.fillRect(-10,-10,820,420); if(nivelActual>=9){ let lat=(Math.sin(frame*0.15)+1)/2; ctx.fillStyle="rgba(255,0,0,"+(0.1+lat*0.25)+")"; ctx.fillRect(-10,-10,820,420); if(Math.floor(frame/15)%2===0){ ctx.strokeStyle="rgba(255,0,0,0.9)"; ctx.lineWidth=8; ctx.strokeRect(0,0,800,400); } } else if(nivelActual>=6){ ctx.strokeStyle="rgba(255,0,0,"+(0.3+intensidad*0.4)+")"; ctx.lineWidth=4+intensidad*4; ctx.strokeRect(0,0,800,400); } if(nivelActual>=9){ for(let i=0;i<10;i++){ let fx=(i*90+frame*2)%800; ctx.font="20px Arial"; ctx.fillText("🔥",fx,385); } } }
  ctx.restore(); ctx.fillStyle="rgba(0,0,0,0.5)"; ctx.fillRect(10,10,200,10); ctx.fillStyle="yellow"; ctx.fillRect(10,10,200*(jugador.x/nivel.largo),10); ctx.fillStyle="white"; ctx.font="11px Arial"; ctx.fillText("Progreso",10,32); ctx.fillStyle="rgba(0,0,0,0.6)"; ctx.fillRect(620,10,170,22); ctx.fillStyle="white"; ctx.font="bold 12px Arial"; ctx.fillText("🔊 "+getVolumenPorc()+"% 🔥 "+getIntensidad()+"% Nv "+nivelActual,628,26); if(nivelActual>=9){ ctx.fillStyle="red"; ctx.font="bold 20px Arial"; ctx.fillText("🔥 MODO EXTREMO 🔥",300,35); }
  requestAnimationFrame(()=>{ actualizar(); dibujar(); });
}
dibujar();
